---
import Layout from "../layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import CodeIcon from "@tabler/icons/outline/code.svg";
import NumbersIcon from "@tabler/icons/outline/numbers.svg";
import LibraryIcon from "@tabler/icons/outline/library.svg";
import SettingsIcon from "@tabler/icons/outline/settings.svg";
import ChevronUpIcon from "@tabler/icons/outline/chevron-up.svg";
import LogoutIcon from "@tabler/icons/outline/logout.svg";

import { Avatar, AvatarFallback, AvatarImage } from "@/components/starwind/avatar";
import { Dropdown, DropdownContent, DropdownItem, DropdownTrigger } from "@/components/starwind/dropdown";
import {
    Sidebar,
    SidebarContent,
    SidebarFooter,
    SidebarGroup,
    SidebarGroupContent,
    SidebarGroupLabel,
    SidebarHeader,
    SidebarMenu,
    SidebarMenuButton,
    SidebarMenuItem,
    SidebarProvider,
    SidebarTrigger,
} from "@/components/starwind/sidebar";

const { ...props } = Astro.props;
const items = [
    { title: "Contadores", url: "/counter", icon: NumbersIcon, active: false },
    { title: "Frases", url: "#", icon: LibraryIcon, active: false },
    { title: "Configurações", url: "#", icon: SettingsIcon, active: false },
];

// Set current page as active
for (let item of items) {
    if (item.title === props.title) {
        item.active = true;
    }
}
---

<Layout {...props}>
    <SidebarProvider>
        <Sidebar collapsible="icon">
            <SidebarHeader>
                <SidebarMenu>
                    <SidebarMenuItem>
                        <SidebarMenuButton size="lg" href="#">
                            <div
                                class="bg-primary text-primary-foreground flex aspect-square size-12 items-center justify-center rounded-lg group-data-[collapsible=icon]:size-10! group-data-[collapsible=icon]:[&_svg]:size-10! [&_svg]:shrink-0"
                            >
                                <Logo size="48" stroke="green" />
                            </div>
                            <div class="grid flex-1 text-left text-sm leading-tight">
                                <span class="truncate font-streamiau font-bold uppercase text-xl">Streamiau!</span>
                            </div>
                        </SidebarMenuButton>
                    </SidebarMenuItem>
                </SidebarMenu>
            </SidebarHeader>

            <SidebarContent>
                <SidebarGroup>
                    <SidebarGroupLabel>Módulos</SidebarGroupLabel>
                    <SidebarGroupContent>
                        <SidebarMenu>
                            {
                                items.map((item) => (
                                    <SidebarMenuItem>
                                        <SidebarMenuButton href={item.url} isActive={item.active}>
                                            <item.icon />
                                            <span>{item.title}</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                ))
                            }
                        </SidebarMenu>
                    </SidebarGroupContent>
                </SidebarGroup>
            </SidebarContent>

            <SidebarFooter>
                <SidebarMenu>
                    <SidebarMenuItem>
                        <Dropdown>
                            <DropdownTrigger asChild>
                                <SidebarMenuButton size="lg">
                                    <Avatar class="size-10 shrink-0 rounded-lg">
                                        <AvatarFallback class="rounded-full">ECR%= initials %ECR</AvatarFallback>
                                    </Avatar>
                                    <div class="grid flex-1 text-left text-sm leading-tight">
                                        <span class="truncate font-semibold">ECR%= username %ECR</span>
                                    </div>
                                    <ChevronUpIcon class="ml-auto size-4" />
                                </SidebarMenuButton>
                            </DropdownTrigger>
                            <DropdownContent class="w-full min-w-48 rounded-lg" side="top">
                                <DropdownItem as="a" href="/logout">
                                    <LogoutIcon class="mr-2 size-4" />
                                    Sair
                                </DropdownItem>
                            </DropdownContent>
                        </Dropdown>
                    </SidebarMenuItem>
                </SidebarMenu>
            </SidebarFooter>
        </Sidebar>

        <main class="bg-background flex flex-1 flex-col">
            <header class="flex h-12 shrink-0 items-center gap-2 border-b px-4">
                <SidebarTrigger />
                <span class="text-muted-foreground text-sm">{props.title}</span>
            </header>
            <div class="relative flex w-full flex-1 flex-col mt-4">
                <slot />
            </div>
        </main>
    </SidebarProvider>
</Layout>

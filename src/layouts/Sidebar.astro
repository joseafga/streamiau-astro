---
import Layout from "@/layouts/Layout.astro";
import LayoutSidebar from "@/components/LayoutSidebar";

const { breadcrumb, ...props } = Astro.props;
const title = breadcrumb.at(-1).title;

const user = {
  username: __ecr("johndoe", "session_user.username"),
  realname: __ecr("John Doe", "session_user.realname"),
  email: __ecr("user@email.com", "session_user.email"),
  role: __ecr(0, "session_user.role.value", ":n"),
  tokens: [],
};
---

<Layout title={`${title} - Streamiau!`} {...props}>
  <LayoutSidebar breadcrumb={breadcrumb} user={user} client:only>
    <slot />
  </LayoutSidebar>
</Layout>

---
import "@/styles/global.css";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import { Toaster } from "@/components/starwind/toast";

interface Props {
    title: string;
    csrfToken?: boolean;
}

const { title, csrfToken } = Astro.props;
---

<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        {csrfToken && <meta name="authenticity-token" content="ECR%= csrf_token %ECR" />}
        <ThemeInitScript defaultTheme="system" />
    </head>
    <body>
        <slot />

        <Toaster position="top-center" />
    </body>
</html>

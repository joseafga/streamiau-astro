---
import Layout from "@/layouts/Sidebar.astro";
import Profile from "@/components/user/Profile";

const data = "ECR%= session_user.to_json %ECR";
---

<Layout title="Perfil">
  <div class="bg-muted/50 flex-1 rounded-xl">
    <div class="container mx-auto max-w-2xl px-4 py-12 sm:py-16">
      <Profile client:load />
    </div>
  </div>

  <script id="user-data" type="application/json" is:inline set:html={data} />
</Layout>

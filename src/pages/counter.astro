---
import { Button } from "@/components/starwind/button";
import { Spinner } from "@/components/starwind/spinner";

import Layout from "@/layouts/Sidebar.astro";
import DataTable from "@/components/counter/DataTable.astro";
import Preview from "@/components/counter/Preview.astro";
import SettingsForm from "@/components/counter/SettingsForm.astro";

let default_style = {
    prefix: "Contador:",
    font_color: "rgb(112, 85, 189)",
    font_size_prefix: 42,
    font_size_counter: 100,
};
---

<Layout title="Contadores - Streamiau!">
    <div class="grid auto-rows-min gap-4 p-4 md:grid-cols-2">
        <div class="bg-muted/50 flex-1 rounded-xl min-h-min p-4 md:col-span-2">
            <DataTable />
        </div>
        <div class="bg-muted/50 rounded-xl">
            <h1 class="text-lg font-extrabold w-full text-center p-6 pb-0">Aparência do Contador</h1>

            <form id="counter-settings-form" class="mx-auto flex flex-col gap-4 p-6">
                <input type="hidden" name="authenticity_token" value="ECR%= csrf_token %ECR" />
                <SettingsForm {...default_style} />
                <div class="mt-4">
                    <Button type="submit">
                        <Spinner id="loading-form" class="hidden" />
                        Aplicar
                    </Button>
                </div>
            </form>
        </div>
        <div class="bg-muted/50 rounded-xl">
            <div class="flex flex-col h-full items-center text-center gap-4 p-6">
                <h1 class="text-lg font-extrabold">Prévia</h1>
                <Preview />
            </div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ default_style }}>
    // Elements
    const counter_radio = document.getElementById("counter-radio");
    const widget_url_input = document.getElementById("widget-url");
    const preview_prefix = document.getElementById("preview-prefix");
    const preview_counter = document.getElementById("preview-counter");
    const copy_url_button = document.getElementById("copy-widget-url");

    let preview_style = default_style;
    let selected_uuid = counter_radio.getAttribute("data-value");

    const update_widget_preview = function () {
        preview_prefix.textContent = preview_style.prefix;
        preview_prefix.style.color = preview_style.font_color;
        preview_counter.style.color = preview_style.font_color;
        preview_prefix.style.fontSize = `${preview_style.font_size_prefix}px`;
        preview_counter.style.fontSize = `${preview_style.font_size_counter}px`;

        let url = `https://streamiau.joseafga.com.br/widgets/counter/${selected_uuid}?style=${encodeURIComponent(JSON.stringify(preview_style))}`;
        widget_url_input.value = url;
    };

    counter_radio?.addEventListener("starwind:value-change", (e) => {
        selected_uuid = e.detail.value;

        update_widget_preview();
    });

    widget_url_input.addEventListener("focus", () => widget_url_input.select());
    widget_url_input.addEventListener("click", () => widget_url_input.select());

    copy_url_button?.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(widget_url_input.value);
            widget_url_input.select();
        } catch (e) {
            console.error("Fail to copy URL:", e);
        }
    });

    document.addEventListener("DOMContentLoaded", () => {
        update_widget_preview();
    });

    // -- SETTINGS --
    const prefix = document.getElementById("prefix-input");
    prefix?.addEventListener("input", (e) => {
        console.log("Value changed:", prefix.value);
        preview_style.prefix = prefix.value;

        update_widget_preview();
    });

    const font_size_prefix_slider = document.getElementById("font-size-prefix-slider");
    font_size_prefix_slider?.addEventListener("slider-change", (e) => {
        preview_style.font_size_prefix = e.detail.value;

        update_widget_preview();
    });

    const font_size_counter_slider = document.getElementById("font-size-counter-slider");
    font_size_counter_slider?.addEventListener("slider-change", (e) => {
        preview_style.font_size_counter = e.detail.value;

        update_widget_preview();
    });

    const color_picker = document.getElementById("color-picker");
    const color_text = document.getElementById("color-text");
    color_picker?.addEventListener("starwind-color-picker:change", (e) => {
        color_text.textContent = e.detail.value;
        preview_style.font_color = e.detail.value;

        update_widget_preview();
    });

    // -- FORM Submit --
    const form = document.getElementById("counter-settings-form");
    const submit_button = form.querySelector('button[type="submit"]');
    const loading_icon = document.getElementById("loading-form");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        submit_button.disabled = true;
        loading_icon.classList.remove("hidden");

        const formData = new FormData(form);

        try {
            const response = await fetch(`/counter/${selected_uuid}/settings`, { method: "POST", body: formData });
            const result = await response.text();

            if (!result == "Success") {
                throw new Error(`Error ${response.status}: ${result}`);
            }

            console.log("Success:", result);
        } catch (err) {
            console.error("Fail:", err);
        }

        submit_button.disabled = false;
        loading_icon.classList.add("hidden");
    });
</script>

---
import CopyIcon from "@tabler/icons/outline/copy.svg";
import LinkIcon from "@tabler/icons/outline/link.svg";
import { Button } from "@/components/starwind/button";
import { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput } from "@/components/starwind/input-group";

import Layout from "@/layouts/Sidebar.astro";
import DataTable from "@/components/counter/DataTable.astro";
import Preview from "@/components/counter/Preview.astro";
import SettingsForm from "@/components/counter/SettingsForm.astro";

let default_style = {
    prefix: "Contador:",
    text_color: "rgb(112, 85, 189)",
    prefix_size: 42,
    counter_size: 100,
};
---

<Layout title="Contadores - Streamiau!">
    <div class="grid auto-rows-min gap-4 p-4 md:grid-cols-2">
        <div class="bg-muted/50 min-h-screen flex-1 rounded-xl md:min-h-min p-4 col-span-2">
            <DataTable />
        </div>
        <div class="bg-muted/50 rounded-xl">
            <form id="generated-form" class="mx-auto flex flex-col gap-4 p-6">
                <SettingsForm {...default_style} />
                <div class="mt-4">
                    <Button type="submit">Aplicar</Button>
                </div>
            </form>
        </div>
        <div class="bg-muted/50 rounded-xl">
            <div class="flex flex-col h-full items-center text-center gap-4 p-6">
                <h1 class="text-lg font-bold">Prévia</h1>
                <Preview />
                <div class="flex flex-row items-center w-full">
                    <InputGroup>
                        <InputGroupInput
                            id="widget-url"
                            name="widget-url"
                            placeholder="https://example.com/widgets/counter/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                            readonly
                        />
                        <InputGroupAddon>
                            <LinkIcon />
                        </InputGroupAddon>
                        <InputGroupAddon align="inline-end">
                            <InputGroupButton id="copy-widget-url" aria-label="Copy" title="Copy" size="icon-sm">
                                <CopyIcon />
                            </InputGroupButton>
                        </InputGroupAddon>
                    </InputGroup>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ default_style }}>
    let preview_style = default_style;
    let url_uuid = "";

    const widget_url_input = document.getElementById("widget-url");
    const preview_prefix = document.getElementById("preview-prefix");
    const preview_counter = document.getElementById("preview-counter");

    const update_widget_preview = function () {
        preview_prefix.textContent = preview_style.prefix;
        preview_prefix.style.color = preview_style.text_color;
        preview_counter.style.color = preview_style.text_color;
        preview_prefix.style.fontSize = `${preview_style.prefix_size}px`;
        preview_counter.style.fontSize = `${preview_style.counter_size}px`;

        let url = `https://streamiau.joseafga.com.br/widgets/counter/${url_uuid}?style=${encodeURIComponent(JSON.stringify(preview_style))}`;
        widget_url_input.value = url;
    };

    const counter_radio = document.getElementById("counter-radio");
    counter_radio?.addEventListener("starwind:value-change", (e) => {
        url_uuid = e.detail.value;

        update_widget_preview();
    });

    const copy_url_button = document.getElementById("copy-widget-url");
    widget_url_input.addEventListener("focus", () => widget_url_input.select());
    widget_url_input.addEventListener("click", () => widget_url_input.select());

    copy_url_button?.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(widget_url_input.value);
            widget_url_input.select();
        } catch (e) {
            console.error("Fail to copy URL:", e);
        }
    });

    document.addEventListener("DOMContentLoaded", () => {
        update_widget_preview();
    });

    // -- SETTINGS --
    const text_prefix = document.getElementById("text-prefix");
    text_prefix?.addEventListener("input", (e) => {
        console.log("Value changed:", text_prefix.value);
        preview_style.prefix = text_prefix.value;

        update_widget_preview();
    });

    const prefix_size_slider = document.getElementById("prefix-size");
    prefix_size_slider?.addEventListener("slider-change", (e) => {
        preview_style.prefix_size = e.detail.value;

        update_widget_preview();
    });

    const counter_size_slider = document.getElementById("counter-size");
    counter_size_slider?.addEventListener("slider-change", (e) => {
        preview_style.counter_size = e.detail.value;

        update_widget_preview();
    });

    const color_picker = document.getElementById("color-picker");
    const color_text = document.getElementById("color-text");
    color_picker?.addEventListener("starwind-color-picker:change", (e) => {
        color_text.textContent = e.detail.value;
        preview_style.text_color = e.detail.value;

        update_widget_preview();
    });
</script>

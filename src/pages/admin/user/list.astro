---
import Layout from "@/layouts/Sidebar.astro";
import UserDataTable from "@/components/user/DataTable";

const data = "ECR%= users.to_json %ECR";
---

<Layout title="Usuários" csrfToken>
  <div class="grid auto-rows-min gap-4">
    <div class="bg-muted/50 rounded-xl p-4">
      <UserDataTable client:load />
    </div>
  </div>

  <script id="users-data" type="application/json" is:inline set:html={data} />
</Layout>

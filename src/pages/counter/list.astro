---
import Layout from "@/layouts/Sidebar.astro";
import CounterCommand from "@/components/counter/CounterCommand";
import CounterCommandUsage from "@/components/counter/CounterCommandUsage";
import DataTable from "@/components/counter/DataTable";
import ObsPlugin from "@/components/counter/ObsPlugin";
import WebPreviewSettings from "@/components/counter/WebPreviewSettings";
import WebPreview from "@/components/counter/WebPreview";

const breadcrumb = [
  { title: "Home", url: "/home" },
  { title: "Contadores", url: "/counter" },
];

const username = __ecr("johndoe", "session_user.username");
const token = __ecr(
  "abcdef1234567890",
  "session_user.tokens.find { |token| token.allow.includes?(User::Token::Type::Counter) }.try(&.value)",
);
const data = __ecr("[]", "counters.to_json");
---

<Layout breadcrumb={breadcrumb} csrfToken>
  <div class="grid auto-rows-min gap-4 md:grid-cols-2">
    <div class="bg-muted/50 flex-1 rounded-xl min-h-min p-4 md:col-span-2">
      <DataTable username={username} client:only />
    </div>
    <div class="bg-muted/50 rounded-xl">
      <ObsPlugin username={username} client:only />
    </div>
    <div class="bg-muted/50 rounded-xl row-span-2">
      <CounterCommandUsage client:only />
    </div>
    <div class="bg-muted/50 rounded-xl">
      <CounterCommand username={username} token={token} client:only />
    </div>

    <div class="bg-muted/50 rounded-xl">
      <WebPreviewSettings client:only />
    </div>
    <div class="bg-muted/50 rounded-xl overflow-clip">
      <WebPreview username={username} client:only />
    </div>
  </div>

  <script id="counters-data" type="application/json" is:inline set:html={data} />
</Layout>

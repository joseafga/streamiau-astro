---
import Layout from "../../layouts/Sidebar.astro";
import { Button } from "@/components/starwind/button";
import SettingsForm from "@/components/counter/SettingsForm.astro";
---

<Layout title="Contadores">
    <div class="flex flex-1 flex-col gap-4 p-4 pt-0">
        <div class="bg-muted/50 min-h-screen flex-1 rounded-xl md:min-h-min p-8">
            <div class="mb-8">
                <h1 class="text-3xl font-extrabold tracking-tight text-balance">Configurações do Contador</h1>
                <p class="text-muted-foreground text-sm leading-3.5 [&:not(:first-child)]:mt-6">
                    As configurações realizadas são aplicadas em todos contadores conectados no momento.
                </p>
            </div>

            <form class="flex flex-col flex-1 space-y-4">
                <SettingsForm />

                <div class="flex flex-row-reverse gap-4 mt-4 border-t-2 pt-4">
                    <Button type="submit">Aplicar</Button>
                    <Button variant="outline" href="/counter">Cancelar</Button>
                </div>
            </form>
        </div>
    </div>
</Layout>

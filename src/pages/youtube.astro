---
import Layout from "@/layouts/Sidebar.astro";
import LastVideoWidget from "@/components/youtube/LastVideo";
import LastShortWidget from "@/components/youtube/LastShort";

const breadcrumb = [
  { title: "Home", url: "/home" },
  { title: "Youtube", url: "/youtube" },
];

const username = __ecr("johndoe", "session_user.username");
const youtubeid = __ecr("yt", "session_user.youtubeid");
---

<Layout breadcrumb={breadcrumb}>
  <div class="grid auto-rows-min gap-4 md:grid-cols-2">
    <div class="bg-muted/50 rounded-xl">
      <LastVideoWidget username={username} youtubeid={youtubeid} client:only />
    </div>
    <div class="bg-muted/50 rounded-xl">
      <LastShortWidget username={username} youtubeid={youtubeid} client:only />
    </div>
  </div>
</Layout>

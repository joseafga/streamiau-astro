---
import Layout from "@/layouts/Sidebar.astro";
import HoursCommandWidget from "@/components/steam/HoursCommand";

const breadcrumb = [
  { title: "Home", url: "/home" },
  { title: "Steam", url: "/steam" },
];

const username = __ecr("johndoe", "session_user.username");
const steamid = __ecr("123456", "session_user.steamid");
---

<Layout breadcrumb={breadcrumb}>
  <div class="grid auto-rows-min gap-4 md:grid-cols-1">
    <!-- <div class="bg-muted/50 rounded-xl row-span-2"></div> -->
    <div class="bg-muted/50 rounded-xl">
      <HoursCommandWidget username={username} steamid={steamid} client:only />
    </div>
  </div>
</Layout>

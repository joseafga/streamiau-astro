---
import Logo from "@/components/Logo.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Streamiau!">
    <main class="grid place-items-center min-h-svh gap-4 overflow-hidden">
        <div class="w-100">
            <Logo
                cat-class="fill-mist-50"
                rect-class="fill-mist-900 dark:fill-transparent"
                class="mx-auto size-64 sm:size-96 pr-4"
            />
            <div class="mx-auto max-w-md text-center">
                <h1 class="font-streamiau text-4xl sm:text-6xl uppercase">Streamiau!</h1>
            </div>
            <p class="text-muted-foreground text-sm text-center mt-6">
                Como ainda estamos dando os primeiros passos, o acesso está restrito. Quer fazer parte dessa jornada com
                a gente? <a
                    class="text-primary-accent whitespace-nowrap hover:underline"
                    href="mailto:streamiau@joseafga.com.br?subject=Pedido de acesso ao Streamiau!"
                    target="_blank"
                    rel="noopener noreferrer">Mande um e-mail para nós!</a
                >
            </p>
        </div>
    </main>
</Layout>

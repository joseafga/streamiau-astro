---
import Layout from "@/layouts/Layout.astro";
import { Logo } from "@/components/Logo";
---

<Layout title="Streamiau!">
  <main class="grid place-items-center min-h-svh gap-4 overflow-hidden">
    <div class="w-100">
      <div class="mx-auto max-w-md [&_svg]:size-64 [&_svg]:md:size-96 grid place-content-center pr-4">
        <Logo catClass="fill-mist-50" rectClass="fill-mist-900 dark:fill-transparent" />
      </div>
      <div class="mx-auto max-w-md text-center">
        <h1 class="font-streamiau font-extrabold uppercase text-4xl md:text-6xl">Streamiau!</h1>
      </div>
      <p class="text-muted-foreground text-sm text-center mt-6">
        Como ainda estamos dando os primeiros passos, o acesso está restrito. Quer fazer parte dessa jornada com a
        gente? <a
          class="text-primary whitespace-nowrap hover:underline"
          href="mailto:streamiau@joseafga.com.br?subject=Pedido de acesso ao Streamiau!"
          target="_blank"
          rel="noopener noreferrer">Mande um e-mail para nós!</a
        >
      </p>
    </div>
  </main>
</Layout>

---
import Logo from "@/components/Logo.astro";
import Layout from "@/layouts/Sidebar.astro";
---

<Layout title="Home - Streamiau!">
    <main class="grid place-items-center h-full gap-4">
        <div>
            <Logo
                catClass="fill-mist-50 dark:fill-mist-900"
                rectClass="fill-mist-200 dark:fill-transparent"
                class="mx-auto size-64 sm:size-96 pr-4"
            />
            <div class="mx-auto max-w-md text-center">
                <h1 class="font-streamiau text-mist-200 dark:text-mist-900 text-4xl sm:text-6xl uppercase">
                    Streamiau!
                </h1>
            </div>
        </div>
    </main>
</Layout>

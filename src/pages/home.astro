---
import Layout from "@/layouts/Sidebar.astro";
import { Logo } from "@/components/Logo";

const breadcrumb = [{ title: "Home", url: "/home" }];
---

<Layout breadcrumb={breadcrumb}>
  <main class="grid place-items-center h-full gap-4">
    <div>
      <div class="mx-auto max-w-md [&_svg]:size-64 [&_svg]:md:size-96 grid place-content-center pr-4">
        <Logo catClass="fill-zinc-50 dark:fill-zinc-900" rectClass="fill-zinc-200 dark:fill-transparent" />
      </div>
      <div class="mx-auto max-w-md text-center">
        <h1 class="text-zinc-200 dark:text-zinc-900 font-streamiau font-extrabold uppercase text-4xl md:text-6xl">
          Streamiau!
        </h1>
      </div>
    </div>
  </main>
</Layout>

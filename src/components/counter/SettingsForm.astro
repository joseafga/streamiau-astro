---
import { Slider } from "@/components/starwind/slider";
import { Button } from "@/components/starwind/button";
import { Label } from "@/components/starwind/label";
import { Input } from "@/components/starwind/input";
import { ColorPicker } from "@/components/starwind/color-picker";

let text = "";
let text_color = "#ff0000";
let text_size = 50;
const text_size_marks = [0, 61, 122, 183, 244];
let counter_size = 50;
const counter_size_marks = [0, 61, 122, 183, 244];
---

<div class="flex flex-col gap-1">
    <Label for="counter-text">Nome (prefixo)</Label>
    <Input id="counter-text" placeholder="Contador" required />
</div>

<div class="flex flex-col gap-1">
    <Label for="counter-text-color">Cor do texto</Label>
    <div class="flex items-center gap-4">
        <ColorPicker defaultValue={text_color} size="lg" />
        {text_color}
    </div>
</div>

<div class="flex flex-col gap-1">
    <div class="flex items-center justify-between">
        <label for="slider">Tamanho do texto</label>
        <span class="text-muted-foreground text-sm">{text_size}</span>
    </div>

    <Slider type="single" bind:value={text_size} max={244} />
    <div class="flex items-center justify-between text-muted-foreground text-xs tabular-nums">
        <span class="w-6 text-left">{text_size_marks[0]}</span>
        <span class="w-6 text-center">{text_size_marks[1]}</span>
        <span class="w-6 text-center">{text_size_marks[2]}</span>
        <span class="w-6 text-center">{text_size_marks[3]}</span>
        <span class="w-6 text-right">{text_size_marks[4]}</span>
    </div>
</div>

<div class="flex flex-col gap-1">
    <div class="flex items-center justify-between">
        <label for="slider">Tamanho do contador</label>
        <span class="text-muted-foreground text-sm">{counter_size}</span>
    </div>

    <Slider type="single" bind:value={counter_size} max={244} />
    <div class="flex items-center justify-between text-muted-foreground text-xs tabular-nums">
        <span class="w-6 text-left">{counter_size_marks[0]}</span>
        <span class="w-6 text-center">{counter_size_marks[1]}</span>
        <span class="w-6 text-center">{counter_size_marks[2]}</span>
        <span class="w-6 text-center">{counter_size_marks[3]}</span>
        <span class="w-6 text-right">{counter_size_marks[4]}</span>
    </div>
</div>

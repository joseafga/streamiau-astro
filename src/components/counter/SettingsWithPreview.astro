---
import CopyIcon from "@tabler/icons/outline/copy.svg";
import LinkIcon from "@tabler/icons/outline/link.svg";
import { Select, SelectContent, SelectItem, SelectSeparator, SelectTrigger } from "@/components/starwind/select";
import { Input } from "@/components/starwind/input";
import { ColorPicker } from "@/components/starwind/color-picker";
import { Slider } from "@/components/starwind/slider";
import { Checkbox } from "@/components/starwind/checkbox";
import { Button } from "@/components/starwind/button";
import { Spinner } from "@/components/starwind/spinner";
import { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput } from "@/components/starwind/input-group";
import { Popover, PopoverContent, PopoverTrigger } from "@/components/starwind/popover";

import { $style } from "@/stores/counter.js";
const default_style = $style.get();
const { class: className, ...rest } = Astro.props;

const fonts_select = ["Inter", "Roboto", "Sniglet"];
const font_size_prefix_marks = [0, 61, 122, 183, 244];
const font_size_counter_marks = [0, 61, 122, 183, 244];
---

<div class:list={[className]} {...rest}>
    <h1 class="text-lg font-extrabold w-full text-center p-6 pb-0">Aparência do Contador</h1>

    <form id="counter-settings-form" class="mx-auto flex flex-col gap-4 p-6">
        <input type="hidden" name="authenticity_token" value="ECR%= csrf_token %ECR" />
        <div class="flex flex-col space-y-2">
            <Select id="font-family-select" name="font-family">
                <SelectTrigger class="w-full" placeholder="Selecione uma fonte..." />
                <SelectContent>
                    {
                        fonts_select.map((font) => (
                            <SelectItem value={font} style={{ fontFamily: font }}>
                                {font}
                            </SelectItem>
                        ))
                    }
                    <SelectSeparator />
                    <SelectItem value="sans-serif" style="font-family: sans-serif">sans-serif</SelectItem>
                    <SelectItem value="serif" style="font-family: serif">serif</SelectItem>
                    <SelectItem value="monospace" style="font-family: monospace">monoespaçada</SelectItem>
                </SelectContent>
            </Select>
        </div>

        <div class="flex flex-col space-y-2">
            <Input
                id="prefix-input"
                name="prefix"
                value={default_style.prefix}
                placeholder="Prefixo"
                autocomplete="off"
            />
        </div>

        <div class="flex flex-col space-y-2">
            <div class="flex items-center gap-4">
                <ColorPicker
                    id="color-picker"
                    name="font-color"
                    format="rgb"
                    formats={["rgb", "hex"]}
                    defaultValue={default_style.font_color}
                    size="lg"
                />
            </div>
        </div>

        <div class="flex flex-col space-y-2">
            <label for="font-size-prefix-slider">Tamanho do prefixo</label>
            <Slider
                id="font-size-prefix-slider"
                name="font-size-prefix"
                value={default_style.font_size_prefix}
                max={244}
            />
            <div class="flex items-center justify-between text-muted-foreground text-xs tabular-nums">
                <span class="w-6 text-left">{font_size_prefix_marks[0]}</span>
                <span class="w-6 text-center">{font_size_prefix_marks[1]}</span>
                <span class="w-6 text-center">{font_size_prefix_marks[2]}</span>
                <span class="w-6 text-center">{font_size_prefix_marks[3]}</span>
                <span class="w-6 text-right">{font_size_prefix_marks[4]}</span>
            </div>
        </div>

        <div class="flex flex-col space-y-2">
            <label for="font-size-counter-slider">Tamanho do contador</label>
            <Slider
                id="font-size-counter-slider"
                name="font-size-counter"
                value={default_style.font_size_counter}
                max={244}
            />
            <div class="flex items-center justify-between text-muted-foreground text-xs tabular-nums">
                <span class="w-6 text-left">{font_size_counter_marks[0]}</span>
                <span class="w-6 text-center">{font_size_counter_marks[1]}</span>
                <span class="w-6 text-center">{font_size_counter_marks[2]}</span>
                <span class="w-6 text-center">{font_size_counter_marks[3]}</span>
                <span class="w-6 text-right">{font_size_counter_marks[4]}</span>
            </div>
        </div>

        <div class="flex flex-col space-y-2">
            <Checkbox id="fixed-style-checkbox" name="fixed-style" label="Não alterar a aparência posteriormente" />
        </div>
        <div class="mt-4">
            <Button type="submit">
                <Spinner id="loading-form" class="hidden" />
                Aplicar
            </Button>
        </div>
    </form>
</div>
<div class:list={[className]} {...rest}>
    <div class="flex flex-col h-full items-center text-center gap-4 p-6">
        <h1 class="text-lg font-extrabold">Prévia</h1>

        <div class="flex-1 flex items-center justify-center gap-2">
            <span id="preview-prefix" class="mr-[0.2em]"></span>
            <span id="preview-counter" class="font-bold transition-all duration-200">150</span>
        </div>
        <div class="flex flex-row items-center w-full">
            <InputGroup>
                <InputGroupInput
                    id="widget-url"
                    name="widget-url"
                    placeholder="https://example.com/widgets/counter/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                    readonly
                />
                <InputGroupAddon>
                    <LinkIcon />
                </InputGroupAddon>
                <InputGroupAddon align="inline-end">
                    <Popover>
                        <PopoverTrigger asChild>
                            <InputGroupButton id="copy-widget-url" aria-label="Copy" title="Copy" size="icon-sm">
                                <CopyIcon />
                            </InputGroupButton>
                        </PopoverTrigger>
                        <PopoverContent side="top" sideOffset={12} class="w-22">Copiado!</PopoverContent>
                    </Popover>
                </InputGroupAddon>
            </InputGroup>
        </div>
    </div>
</div>

<script>
    import type { ColorPickerChangeEvent } from "@/components/starwind/color-picker/ColorPickerTypes";

    type ProgrammaticColorPickerElement = HTMLElement & {
        setValue: (newRgb: string) => void;
    };

    import { $username, $uuid, $style } from "@/stores/counter.js";

    // Elements
    const widget_url_input = document.getElementById("widget-url") as HTMLInputElement;
    const preview_prefix = document.getElementById("preview-prefix") as HTMLSpanElement;
    const preview_counter = document.getElementById("preview-counter") as HTMLSpanElement;
    const copy_url_button = document.getElementById("copy-widget-url") as HTMLButtonElement;

    const URL_ORIGIN = window.location.origin;
    const update_url_preview = function () {
        let settings_encoded = encodeURIComponent(JSON.stringify($style.get()));
        let url = `${URL_ORIGIN}/widgets/counter/?username=${$username.get()}&uuid=${$uuid.get()}&settings=${settings_encoded}`;

        widget_url_input.value = url;
    };

    const update_widget_preview = function () {
        preview_prefix.style.fontFamily = $style.get().font_family;
        preview_counter.style.fontFamily = $style.get().font_family;
        preview_prefix.textContent = $style.get().prefix;
        preview_prefix.style.color = $style.get().font_color;
        preview_counter.style.color = $style.get().font_color;
        preview_prefix.style.fontSize = `${$style.get().font_size_prefix}px`;
        preview_counter.style.fontSize = `${$style.get().font_size_counter}px`;

        update_url_preview();
    };

    // Copy URL feature
    widget_url_input.addEventListener("focus", () => widget_url_input.select());
    copy_url_button.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(widget_url_input.value);
            widget_url_input.select();
        } catch (e) {
            console.error("Fail to copy URL:", e);
        }
    });

    $uuid.subscribe((value) => {
        update_url_preview();
    });

    $style.subscribe((value) => {
        update_widget_preview();
    });

    document.addEventListener("DOMContentLoaded", () => {
        update_widget_preview();
    });

    // -- SETTINGS --
    const font_family = document.getElementById("font-family-select") as HTMLDivElement;
    font_family.addEventListener("starwind:value-change", (event) => {
        const { value } = (event as CustomEvent<{ value: string | null }>).detail;
        if (value) $style.setKey("font_family", value);
    });

    const prefix = document.getElementById("prefix-input") as HTMLInputElement;
    prefix.addEventListener("input", (e) => {
        $style.setKey("prefix", prefix.value);
    });

    const font_size_prefix_slider = document.getElementById("font-size-prefix-slider");
    font_size_prefix_slider?.addEventListener("starwind:value-change", (event) => {
        const { value } = (event as CustomEvent<{ value: number }>).detail;
        $style.setKey("font_size_prefix", value);
    });

    const font_size_counter_slider = document.getElementById("font-size-counter-slider");
    font_size_counter_slider?.addEventListener("starwind:value-change", (event) => {
        const { value } = (event as CustomEvent<{ value: number }>).detail;
        $style.setKey("font_size_counter", value);
    });

    const color_picker = document.getElementById("color-picker") as ProgrammaticColorPickerElement;
    color_picker.addEventListener("starwind:value-change", (event) => {
        const { valueAsString } = (event as CustomEvent<{ valueAsString: string }>).detail;
        console.log(event);
        $style.setKey("font_color", valueAsString);
    });

    const fixed_style_checkbox = document.getElementById("fixed-style-checkbox");
    fixed_style_checkbox?.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        $style.setKey("fixed_style", target.checked);
    });

    // -- FORM Submit --
    const form = document.getElementById("counter-settings-form") as HTMLFormElement;
    const submit_button = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
    const loading_icon = document.getElementById("loading-form");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        submit_button.disabled = true;
        loading_icon?.classList.remove("hidden");

        const form_data = new FormData(form);

        try {
            const response = await fetch(`/counter/${$uuid.get()}/settings`, { method: "POST", body: form_data });
            const result = await response.text();

            if (result != "Success") {
                throw new Error(`Error ${response.status}: ${result}`);
            }

            console.log("Success:", result);
        } catch (err) {
            console.error("Fail:", err);
        }

        submit_button.disabled = false;
        loading_icon?.classList.add("hidden");
    });
</script>

---
import CopyIcon from "@tabler/icons/outline/copy.svg";
import LinkIcon from "@tabler/icons/outline/link.svg";
import { Select, SelectContent, SelectItem, SelectSeparator, SelectTrigger } from "@/components/starwind/select";
import { Input } from "@/components/starwind/input";
import { ColorPicker } from "@/components/starwind/color-picker";
import { Slider } from "@/components/starwind/slider";
import { Checkbox } from "@/components/starwind/checkbox";
import { Button } from "@/components/starwind/button";
import { Spinner } from "@/components/starwind/spinner";
import { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput } from "@/components/starwind/input-group";
import { Popover, PopoverContent, PopoverTrigger } from "@/components/starwind/popover";

import { $style } from "@/stores/counter.js";
const defaultStyle = $style.get();
const { class: className, ...rest } = Astro.props;

const fontsSelect = ["Inter", "Roboto", "Sniglet"];
const fontSizePrefixMarks = [0, 61, 122, 183, 244];
const fontSizeCounterMarks = [0, 61, 122, 183, 244];
---

<div class:list={[className, "row-span-2"]} {...rest}>
    <h1 class="text-lg font-extrabold w-full text-center p-6 pb-0">Aparência do Contador</h1>

    <form id="counter-settings-form" class="mx-auto flex flex-col gap-4 p-6">
        <input type="hidden" name="authenticity_token" value="ECR%= csrf_token %ECR" />
        <div class="flex flex-col space-y-2">
            <Select id="font-family-select" name="font-family">
                <SelectTrigger class="w-full" placeholder="Selecione uma fonte..." />
                <SelectContent>
                    {
                        fontsSelect.map((font) => (
                            <SelectItem value={font} style={{ fontFamily: font }}>
                                {font}
                            </SelectItem>
                        ))
                    }
                    <SelectSeparator />
                    <SelectItem value="sans-serif" style="font-family: sans-serif">sans-serif</SelectItem>
                    <SelectItem value="serif" style="font-family: serif">serif</SelectItem>
                    <SelectItem value="monospace" style="font-family: monospace">monoespaçada</SelectItem>
                </SelectContent>
            </Select>
        </div>

        <div class="flex flex-col space-y-2">
            <Input
                id="prefix-input"
                name="prefix"
                value={defaultStyle.prefix}
                placeholder="Prefixo"
                autocomplete="off"
            />
        </div>

        <div class="flex flex-col space-y-2">
            <div class="flex items-center gap-4">
                <ColorPicker
                    id="color-picker"
                    name="font-color"
                    format="rgb"
                    formats={["rgb", "hex"]}
                    defaultValue={defaultStyle.fontColor}
                    size="lg"
                />
            </div>
        </div>

        <div class="flex flex-col space-y-2">
            <label for="font-size-prefix-slider">Tamanho do prefixo</label>
            <Slider
                id="font-size-prefix-slider"
                name="font-size-prefix"
                value={defaultStyle.fontSizePrefix}
                max={244}
            />
            <div class="flex items-center justify-between text-muted-foreground text-xs tabular-nums">
                <span class="w-6 text-left">{fontSizePrefixMarks[0]}</span>
                <span class="w-6 text-center">{fontSizePrefixMarks[1]}</span>
                <span class="w-6 text-center">{fontSizePrefixMarks[2]}</span>
                <span class="w-6 text-center">{fontSizePrefixMarks[3]}</span>
                <span class="w-6 text-right">{fontSizePrefixMarks[4]}</span>
            </div>
        </div>

        <div class="flex flex-col space-y-2">
            <label for="font-size-counter-slider">Tamanho do contador</label>
            <Slider
                id="font-size-counter-slider"
                name="font-size-counter"
                value={defaultStyle.fontSizeCounter}
                max={244}
            />
            <div class="flex items-center justify-between text-muted-foreground text-xs tabular-nums">
                <span class="w-6 text-left">{fontSizeCounterMarks[0]}</span>
                <span class="w-6 text-center">{fontSizeCounterMarks[1]}</span>
                <span class="w-6 text-center">{fontSizeCounterMarks[2]}</span>
                <span class="w-6 text-center">{fontSizeCounterMarks[3]}</span>
                <span class="w-6 text-right">{fontSizeCounterMarks[4]}</span>
            </div>
        </div>

        <div class="flex flex-col space-y-2">
            <Checkbox id="fixed-style-checkbox" name="fixed-style" label="Não alterar a aparência posteriormente" />
        </div>
        <div class="mt-4">
            <Button type="submit">
                <Spinner id="loading-form" class="hidden" />
                Aplicar
            </Button>
        </div>
    </form>
</div>
<div class:list={[className]} {...rest}>
    <div class="flex flex-col h-full items-center text-center gap-4 p-6">
        <h1 class="text-lg font-extrabold">Prévia do Widget - Web (Obsoleto)</h1>

        <div class="flex-1 flex items-center justify-center gap-2">
            <span id="preview-prefix" class="mr-[0.2em]"></span>
            <span id="preview-counter" class="font-bold transition-all duration-200">150</span>
        </div>
        <div class="flex flex-row items-center w-full">
            <InputGroup>
                <InputGroupInput id="widget-url" name="widget-url" readonly />
                <InputGroupAddon>
                    <LinkIcon />
                </InputGroupAddon>
                <InputGroupAddon align="inline-end">
                    <Popover>
                        <PopoverTrigger asChild>
                            <InputGroupButton id="copy-widget-url" aria-label="Copy" title="Copy" size="icon-sm">
                                <CopyIcon />
                            </InputGroupButton>
                        </PopoverTrigger>
                        <PopoverContent side="top" sideOffset={12} class="w-22">Copiado!</PopoverContent>
                    </Popover>
                </InputGroupAddon>
            </InputGroup>
        </div>
    </div>
</div>
<div class:list={[className]} {...rest}>
    <div class="flex flex-col h-full items-center text-center gap-4 p-6">
        <h1 class="text-lg font-extrabold">WebSocket - OBS Plugin</h1>
        <div class="flex-1 flex items-center justify-center gap-2">
            <p>
                Para utilização com o <a
                    href="https://github.com/joseafga/streamiau-obs-counter"
                    target="_blank"
                    class="text-primary hover:underline">Plugin do OBS</a
                >. Insira o valor abaixo no campo de <strong>`WebSocket`</strong> das configurações do plugin.
            </p>
        </div>
        <div class="flex flex-row items-center w-full">
            <InputGroup>
                <InputGroupInput id="ws-url" name="ws-url" readonly />
                <InputGroupAddon>
                    <LinkIcon />
                </InputGroupAddon>
                <InputGroupAddon align="inline-end">
                    <Popover>
                        <PopoverTrigger asChild>
                            <InputGroupButton id="copy-ws-url" aria-label="Copy" title="Copy" size="icon-sm">
                                <CopyIcon />
                            </InputGroupButton>
                        </PopoverTrigger>
                        <PopoverContent side="top" sideOffset={12} class="w-22">Copiado!</PopoverContent>
                    </Popover>
                </InputGroupAddon>
            </InputGroup>
        </div>
    </div>
</div>

<script>
    import { $username, $uuid, $style } from "@/stores/counter.js";

    function handleSettingsPreview() {
        // Web Widget
        const widgetUrlInput = document.getElementById("widget-url") as HTMLInputElement;
        const previewPrefix = document.getElementById("preview-prefix") as HTMLSpanElement;
        const previewCounter = document.getElementById("preview-counter") as HTMLSpanElement;
        const copyUrlButton = document.getElementById("copy-widget-url") as HTMLButtonElement;

        const URL_ORIGIN = window.location.origin;
        const updateUrlPreview = function () {
            let settings_encoded = encodeURIComponent(JSON.stringify($style.get()));
            let url = `${URL_ORIGIN}/widgets/counter/?username=${$username.get()}&uuid=${$uuid.get()}&settings=${settings_encoded}`;

            widgetUrlInput.value = url;
        };

        widgetUrlInput.addEventListener("focus", () => widgetUrlInput.select());
        copyUrlButton.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(widgetUrlInput.value);
                widgetUrlInput.select();
            } catch (e) {
                console.error("Fail to copy URL:", e);
            }
        });

        const updateWidgetPreview = function () {
            previewPrefix.style.fontFamily = $style.get().fontFamily;
            previewCounter.style.fontFamily = $style.get().fontFamily;
            previewPrefix.textContent = $style.get().prefix;
            previewPrefix.style.color = $style.get().fontColor;
            previewCounter.style.color = $style.get().fontColor;
            previewPrefix.style.fontSize = `${$style.get().fontSizePrefix}px`;
            previewCounter.style.fontSize = `${$style.get().fontSizeCounter}px`;

            updateUrlPreview();
        };

        // WebSocket
        const wsUrlInput = document.getElementById("ws-url") as HTMLInputElement;
        const copyWsUrlButton = document.getElementById("copy-ws-url") as HTMLButtonElement;

        const WS_URL_PROTOCOL = window.location.protocol == "http:" ? "ws:" : "wss:";
        const WS_URL_HOST = window.location.host;

        const updateWsUrl = function () {
            let url = `${WS_URL_PROTOCOL}//${WS_URL_HOST}/api/v1/counter/${$username.get()}/${$uuid.get()}/ws`;

            wsUrlInput.value = url;
        };

        wsUrlInput.addEventListener("focus", () => wsUrlInput.select());
        copyWsUrlButton.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(wsUrlInput.value);
                wsUrlInput.select();
            } catch (e) {
                console.error("Fail to copy URL:", e);
            }
        });

        // Updates
        $uuid.subscribe((value) => {
            updateUrlPreview();
            updateWsUrl();
        });

        $style.subscribe((value) => {
            updateWidgetPreview();
        });

        document.addEventListener("DOMContentLoaded", () => {
            updateWidgetPreview();
            updateWsUrl();
        });

        // -- SETTINGS --
        const fontFamily = document.getElementById("font-family-select") as HTMLDivElement;
        fontFamily.addEventListener("starwind:value-change", (event) => {
            const { value } = (event as CustomEvent<{ value: string | null }>).detail;
            if (value) $style.setKey("fontFamily", value);
        });

        const prefix = document.getElementById("prefix-input") as HTMLInputElement;
        prefix.addEventListener("input", (e) => {
            $style.setKey("prefix", prefix.value);
        });

        const fontSizePrefixSlider = document.getElementById("font-size-prefix-slider");
        fontSizePrefixSlider?.addEventListener("starwind:value-change", (event) => {
            const { value } = (event as CustomEvent<{ value: number }>).detail;
            $style.setKey("fontSizePrefix", value);
        });

        const fontSizeCounterSlider = document.getElementById("font-size-counter-slider");
        fontSizeCounterSlider?.addEventListener("starwind:value-change", (event) => {
            const { value } = (event as CustomEvent<{ value: number }>).detail;
            $style.setKey("fontSizeCounter", value);
        });

        const colorPicker = document.getElementById("color-picker") as HTMLElement;
        colorPicker.addEventListener("starwind:value-change", (event) => {
            const { valueAsString } = (event as CustomEvent<{ valueAsString: string }>).detail;
            console.log(event);
            $style.setKey("fontColor", valueAsString);
        });

        const fixedStyleCheckbox = document.getElementById("fixed-style-checkbox");
        fixedStyleCheckbox?.addEventListener("change", (e) => {
            const target = e.target as HTMLInputElement;
            $style.setKey("fixedStyle", target.checked);
        });

        // Form Submit
        const form = document.getElementById("counter-settings-form") as HTMLFormElement;
        const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const loadingSpinner = form.querySelector('svg[data-slot="spinner"]') as HTMLElement;

        const loadingStart = () => {
            form.setAttribute("aria-busy", "true");
            loadingSpinner?.classList.remove("hidden");
            submitButton.disabled = true;
        };

        const loadingFinish = () => {
            form.removeAttribute("aria-busy");
            loadingSpinner?.classList.add("hidden");
            submitButton.disabled = false;
        };

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            loadingStart();

            try {
                const formData = new FormData(form);
                const response = await fetch(`/counter/${$uuid.get()}/settings`, { method: "POST", body: formData });
                const result = await response.text();

                if (result != "Success") {
                    throw new Error(`Error ${response.status}: ${result}`);
                }

                console.log("Success:", result);
            } catch (err) {
                console.error("Fail:", err);
            }

            loadingFinish();
        });
    }

    handleSettingsPreview();
    document.addEventListener("astro:after-swap", handleSettingsPreview);
</script>

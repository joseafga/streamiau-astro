---
import TrashIcon from "@tabler/icons/outline/trash.svg";
import { RadioGroup, RadioGroupItem } from "@/components/starwind/radio-group";
import { Label } from "@/components/starwind/label";

import {
    Table,
    TableHeader,
    TableHead,
    TableBody,
    TableRow,
    TableCell,
    TableCaption,
} from "@/components/starwind/table";
import { Button } from "@/components/starwind/button";
---

<RadioGroup
    id="counter-radio"
    name="counter-radio"
    defaultValue="ECR%= counters.first?.try(&.[:uuid]) %ECR"
    legend="Choose an option"
>
    <Table>
        <TableHeader>
            <TableRow>
                <TableHead>Selecione UUID</TableHead>
                <TableHead>Valor</TableHead>
                <TableHead>Data</TableHead>
                <TableHead>Anotação</TableHead>
                <TableHead class="text-right">Ações</TableHead>
            </TableRow>
        </TableHeader>
        <TableBody>
            ECR% counters.each_with_index do |counter, index| %ECR
            <TableRow>
                <TableCell class="font-medium">
                    <div class="flex gap-2 items-center">
                        <RadioGroupItem
                            id="option-ECR%= index %ECR"
                            value="ECR%= counter[:uuid] %ECR"
                            name="counter-radio-1"
                        />
                        <Label for="option-ECR%= index %ECR">ECR%= counter[:uuid] %ECR</Label>
                    </div>
                </TableCell>
                <TableCell>ECR%= counter[:value] %ECR</TableCell>
                <TableCell>ECR%= counter[:date] %ECR</TableCell>
                <TableCell>ECR%= counter[:note] %ECR</TableCell>
                <TableCell class="text-right">
                    <div class="flex flex-row-reverse gap-2">
                        <Button variant="error" size="icon" aria-label="Submit">
                            <TrashIcon />
                        </Button>
                    </div>
                </TableCell>
            </TableRow>
            ECR% end %ECR
        </TableBody>
    </Table>
</RadioGroup>

<script>
    import type { RadioGroupChangeEvent } from "@/components/starwind/radio-group";
    import { $uuid } from "@/stores/counter.js";

    const counter_radio = document.getElementById("counter-radio");
    counter_radio?.addEventListener("starwind:value-change", (e) => {
        const event = e as RadioGroupChangeEvent;
        $uuid.set(event.detail.value);
    });

    // initial state
    $uuid.set(counter_radio?.getAttribute("data-value") || "");
</script>

---
import TrashIcon from "@tabler/icons/outline/trash.svg";
import { RadioGroup, RadioGroupItem } from "@/components/starwind/radio-group";
import { Label } from "@/components/starwind/label";

import {
    Table,
    TableHeader,
    TableHead,
    TableBody,
    TableRow,
    TableCell,
    TableCaption,
} from "@/components/starwind/table";
import { Button } from "@/components/starwind/button";
---

<RadioGroup
    id="counter-radio"
    name="counter-radio"
    defaultValue="ECR%= counters.first?.try(&.uuid) %ECR"
    legend="Choose an option"
>
    <Table>
        <TableHeader>
            <TableRow>
                <TableHead>Selecione UUID</TableHead>
                <TableHead>Valor</TableHead>
                <TableHead>Data</TableHead>
                <TableHead>Origem</TableHead>
                <TableHead>Mensagem</TableHead>
                <TableHead class="text-right">Ações</TableHead>
            </TableRow>
        </TableHeader>
        <TableBody>
            ECR% counters.each_with_index do |counter, index| %ECR
            <TableRow>
                <TableCell class="font-semibold">
                    <div class="flex gap-2 items-center">
                        <RadioGroupItem
                            id="option-ECR%= index %ECR"
                            value="ECR%= counter.uuid %ECR"
                            name="counter-radio-1"
                        />
                        <Label for="option-ECR%= index %ECR">ECR%= counter.uuid %ECR</Label>
                    </div>
                </TableCell>
                <TableCell>ECR%= counter.value %ECR</TableCell>
                ECR% if metadata = counter.metadata %ECR
                <TableCell><time datetime="ECR%= metadata.time %ECR" data-date></time></TableCell>
                <TableCell>ECR%= metadata.sender %ECR</TableCell>
                <TableCell>ECR%= metadata.message %ECR</TableCell>
                ECR% else %ECR
                <TableCell />
                <TableCell />
                <TableCell />
                ECR% end %ECR
                <TableCell class="text-right">
                    <div class="flex flex-row-reverse gap-2">
                        <Button variant="error" size="icon" aria-label="Submit">
                            <TrashIcon />
                        </Button>
                    </div>
                </TableCell>
            </TableRow>
            ECR% end %ECR
        </TableBody>
    </Table>
</RadioGroup>

<script>
    import { $uuid } from "@/stores/counter.js";

    function handleTableSelect() {
        const counterRadio = document.getElementById("counter-radio") as HTMLElement;
        counterRadio.addEventListener("starwind:value-change", (event) => {
            const { value } = (event as CustomEvent<{ value: string }>).detail;
            $uuid.set(value);
        });

        // initial state
        $uuid.set(counterRadio.getAttribute("data-value") || "");
    }

    function formatDates() {
        document.querySelectorAll("[data-date]").forEach((el) => {
            const iso = el.getAttribute("datetime") || el.textContent;
            if (!iso) return;

            el.textContent = new Date(iso).toLocaleDateString("pt-BR", {
                day: "2-digit",
                month: "2-digit",
                year: "2-digit",
                hour: "2-digit",
                minute: "2-digit",
            });
        });
    }

    handleTableSelect();
    formatDates();
    document.addEventListener("astro:after-swap", handleTableSelect);
    document.addEventListener("astro:after-swap", formatDates);
</script>

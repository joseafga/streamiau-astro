---
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import { Input } from "@/components/starwind/input";
---

<Card class="mx-auto w-full max-w-sm">
    <CardHeader>
        <CardTitle class="text-2xl">Login</CardTitle>
        <CardDescription>Entre com o seu nome de usuário, um email será enviado com o link de acesso.</CardDescription>
    </CardHeader>
    <form id="login-form" method="post" action="/login">
        <CardContent class="flex flex-col gap-4">
            <input type="hidden" name="authenticity_token" value="ECR%= csrf_token %ECR" />
            ECR% if redirect_to %ECR
            <input type="hidden" name="redirect_to" value="ECR%= redirect_to %ECR" />
            ECR% end %ECR
            <div class="flex w-full flex-col gap-2">
                <Input id="username" name="username" type="text" placeholder="Nome de Usuário" required />
            </div>
            <Button variant="primary" type="submit" class="w-full">Login</Button>
            <p class="text-sm text-center text-muted-foreground">
                Ainda não tem conta? <a
                    class="text-primary-accent whitespace-nowrap hover:underline"
                    href="mailto:streamiau@joseafga.com.br">streamiau@joseafga.com.br</a
                >
            </p>
        </CardContent>
    </form>
</Card>

<script>
    import { toast } from "@starwind-ui/astro/toast";

    const login_form = document.getElementById("login-form") as HTMLFormElement;

    login_form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(login_form);

        toast.promise(
            fetch(login_form.action, {
                method: "POST",
                body: formData,
            }).then(async (res) => {
                const message = await res.text();

                if (!res.ok) throw new Error(message);
                return message;
            }),
            {
                loading: "Realizando o login...",
                success: (message) => ({
                    title: "Sucesso",
                    description: message,
                }),
                error: (err) => ({
                    title: "Erro",
                    description: err.message,
                }),
            },
        );
    });
</script>
